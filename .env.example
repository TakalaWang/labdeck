# 複製成 .env 後 chmod 600 .env（含 OAuth secret 與 session key）。變數說明見 docs/design.md 約定 B。
# image（docs/deploy.md）：預設從 GHCR 拉預先建好的 image。LABDECK_VERSION 建議固定成某個版本（例如 1.0.0）；latest＝最新正式版、main＝main 分支最新。
# 從原始碼建置（docker compose build）時改成 LABDECK_IMAGE_PREFIX=labdeck、LABDECK_VERSION=local
LABDECK_IMAGE_PREFIX=ghcr.io/takalawang/labdeck
LABDECK_VERSION=latest
PUBLIC_URL=https://dashboard.example.org
SITE_ADDRESS=dashboard.example.org
# 憑證：local（內部 CA，預設）｜cloudflare（DNS-01，需 CLOUDFLARE_API_TOKEN）｜public（HTTP-01）；見 docs/deploy.md
CADDY_TLS=local
CLOUDFLARE_API_TOKEN=
SITE_NAME=LabDeck
# 容器時區（排程、顯示）；未設定為 UTC
TZ=Asia/Taipei
# 必填、至少 32 字元（未設定則 web、runner 拒絕啟動）：openssl rand -base64 48 | tr -d '\n'
SESSION_SECRET=
# portal 的通知（申請、job 結果）；告警走 secrets/discord_webhook
DISCORD_WEBHOOK_URL=
# 網頁圖表向 Prometheus 查詢的位址（compose 內部網路，不對外）
# PROMETHEUS_URL=http://prometheus:9090

# OAuth 2.0 登入；預設值以 NYCU 為例（https://id.nycu.edu.tw/apply/app），其他提供者改下列 OAUTH_*，redirect URI = ${PUBLIC_URL}/auth/callback
OAUTH_NAME=NYCU
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=https://id.nycu.edu.tw/o/authorize/
# token endpoint 以 client_secret_post 驗證
OAUTH_TOKEN_URL=https://id.nycu.edu.tw/o/token/
# profile endpoint 以 Bearer token 呼叫，回傳 JSON
OAUTH_PROFILE_URL=https://id.nycu.edu.tw/api/profile/
OAUTH_SCOPE=profile
# profile JSON 中的身分 ID 與 email 欄位名稱
OAUTH_ID_FIELD=username
OAUTH_EMAIL_FIELD=email

# runner 登入各主機用的帳號（ansible/playbooks/bootstrap_bot.yaml 建立）
BOT_USER=labbot
# 額外保留帳號，逗號分隔，例如各主機共用的管理帳號；root 與 BOT_USER 一律保留
RESERVED_USERS=
# 新帳號 UID 分配區段
UID_MIN=20000
UID_MAX=29999
# 主機上的資料碟掛載點 glob（collect 的 mounts、du 每週掃描的根目錄）
DATA_MOUNT_GLOB=/data*
# node_exporter 的 port；網路邊界擋了 9100 時（常見於校園網路）改用其他 port，改完重跑安裝監控
NODE_EXPORTER_PORT=9100
# 監控主機連到各主機時的來源 IP 或 CIDR（主機看到的位址）。「安裝監控」會在有啟用 ufw 的主機上只對它開放
# NODE_EXPORTER_PORT；bootstrap 時 bot 的 SSH key 也預設只接受它。空白＝不動防火牆
MONITORING_SOURCE=

# 個人通知（選填，成員在「我的帳號」自行開啟；見 docs/deploy.md「個人通知」）。空白＝該管道不提供
# Discord OAuth2 app（scope identify），redirect URI = ${PUBLIC_URL}/auth/discord/callback；通知以 @提及 發在 DISCORD_WEBHOOK_URL
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# SMTP：587 + STARTTLS（SMTP_SECURITY=starttls，預設）或 465（SMTP_SECURITY=ssl）；Gmail 用應用程式密碼
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
